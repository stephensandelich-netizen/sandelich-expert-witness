---
import Button from "@/components/button/Button.astro";
import Contact from "@/components/contact/Contact.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";
import BaseLayout from "@/layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);

// Legal-relevant subset of the full publication record. The complete list
// lives on sandelichlab.org and Google Scholar, linked below.
//
// Links: a direct DOI where the CV gives one or the journal has a fully
// predictable DOI scheme (Cureus); a PubMed search for the exact title
// otherwise. Real, working links only — nothing guessed.
function pubmedSearch(title: string) {
  return `https://pubmed.ncbi.nlm.nih.gov/?term=${encodeURIComponent(title)}`;
}

const rawPublications = [
  { title: "Vital signs among emergency department trauma patients in the setting of alcohol or drug use", journal: "Injury", year: 2024, url: "https://doi.org/10.1016/j.injury.2023.111024" },
  { title: "A Comparison of Pediatric Prehospital Opioid Encounters and Social Vulnerability", journal: "Prehospital Emergency Care", year: 2025, url: "https://doi.org/10.1080/10903127.2024.2424335" },
  { title: "Acute opioid overdose in pediatric patients", journal: "J Am Coll Emerg Physicians Open", year: 2024, url: "https://doi.org/10.1002/emp2.13134" },
  { title: "Emergency department management of opioid use disorder in pediatric patients", journal: "J Am Coll Emerg Physicians Open", year: 2024, url: "https://doi.org/10.1002/emp2.13265" },
  { title: "Association Between Substance Use and Trauma Outcomes in Adolescents", journal: "Western Journal of Emergency Medicine", year: 2026, url: "https://doi.org/10.5811/westjem.50673" },
  { title: "A National Survey of Pediatric Emergency Medicine Clinicians' Comfort Level, Beliefs, and Experiences With Initiating Buprenorphine in the Emergency Department", journal: "Cureus", year: 2024, url: "https://doi.org/10.7759/cureus.69331" },
  { title: "Rapid progression of orbital abscess requiring lateral canthotomy in a pediatric patient", journal: "American Journal of Emergency Medicine", year: 2024, url: "https://doi.org/10.1016/j.ajem.2024.04.028" },
  { title: "Septic Shock Caused by a Perforated Appendix", journal: "Critical Decisions in Emergency Medicine", year: 2024 },
  { title: "Nonaccidental Trauma", journal: "Trauma Reports", year: 2023 },
  { title: "Pediatric Chest Trauma", journal: "Trauma Reports", year: 2023 },
  { title: "Substance Use Disorder", journal: "Emergency Medicine Clinics of North America", year: 2024, url: "https://doi.org/10.1016/j.emc.2023.06.023" },
  { title: "Community-acquired Pneumonia in Children", journal: "Emergency Medicine Clinics of North America", year: 2025, url: "https://doi.org/10.1016/j.emc.2025.06.008" },
];

const publications = rawPublications.map((pub) => ({
  ...pub,
  url: pub.url ?? pubmedSearch(pub.title),
}));
---

<BaseLayout
  title={`Research & Publications | ${siteData.name}`}
  description="Peer-reviewed research relevant to pediatric emergency medicine, trauma, and adolescent substance use cases."
  navStyle="default"
>
  <section class="site-container py-16 md:py-24">
    <h1 class="text-primary h1">Research & Publications</h1>
    <p class="text-muted-foreground mt-4 max-w-2xl md:text-lg">
      A selection of peer-reviewed work most relevant to legal case review — pediatric trauma,
      substance use, and emergency department standards of care. For the complete record,
      including grants, presentations, and CV, see the links below.
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <Button variant="primary" href="https://scholar.google.com/citations?user=6BzNjZMAAAAJ">
        Full record on Google Scholar
      </Button>
      <Button variant="outline" href="https://www.sandelichlab.org/researches">
        Full list on the Sandelich Lab site
      </Button>
    </div>

    <div class="mt-12 divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-700 dark:border-gray-700">
      {
        publications.map((pub) => (
          <article class="grid gap-2 py-5 md:grid-cols-[4rem_minmax(0,1fr)] md:items-baseline md:gap-6">
            <p class="text-muted-foreground text-sm font-semibold tabular-nums">{pub.year}</p>
            <div>
              <h3 class="font-heading text-lg font-semibold">
                <a href={pub.url} target="_blank" rel="noreferrer" class="hover:text-primary underline hover:no-underline">
                  {pub.title}
                </a>
              </h3>
              <p class="text-muted-foreground mt-1">{pub.journal}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <Contact />
</BaseLayout>
