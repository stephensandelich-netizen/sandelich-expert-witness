---
import AboutSideCards from "@/components/about/AboutSideCards.astro";
import AboutSideImage from "@/components/about/AboutSideImage.astro";
import Contact from "@/components/contact/Contact.astro";
import HeroSwoosh from "@/components/hero/HeroSwoosh.astro";
import TeamSwiper from "@/components/team/TeamSwiper.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";
import BaseLayout from "@/layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
---

<BaseLayout
  title={`About | ${siteData.name}`}
  description="Dr. Stephen Sandelich, MD is a board-certified Pediatric Emergency Medicine physician and Assistant Professor at Penn State Health, with over a decade of clinical and legal consulting experience."
  navStyle="default"
>
  <HeroSwoosh />
  <AboutSideImage />
  <AboutSideCards />
  <Contact />
</BaseLayout>
